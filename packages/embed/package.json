{
  "name": "@alcuin/embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,iife --dts --global-name AlcuinEmbed --clean",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types src/i18n.test.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@alcuin/sse-client": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
