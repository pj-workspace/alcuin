# API
ALCUIN_DATABASE_URL=postgresql://alcuin:alcuin@localhost:5432/alcuin
ALCUIN_POSTGRES_POOL_MIN_SIZE=1
ALCUIN_POSTGRES_POOL_MAX_SIZE=10
ALCUIN_POSTGRES_POOL_TIMEOUT_SECONDS=10
ALCUIN_SIGNING_SECRET=replace-me-before-deployment
ALCUIN_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# DeepSeek preset. Keep the real key only in the ignored local .env file.
ALCUIN_DEEPSEEK_API_KEY=
ALCUIN_DEEPSEEK_BASE_URL=https://api.deepseek.com
ALCUIN_DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
ALCUIN_DEEPSEEK_PROTOCOL=chat_completions

# Self-hosted public web search. Docker Compose exposes SearXNG at localhost:9888.
ALCUIN_SEARXNG_URL=http://localhost:9888
ALCUIN_SEARXNG_TIMEOUT_SECONDS=8
ALCUIN_WEB_SEARCH_TOTAL_TIMEOUT_SECONDS=15
ALCUIN_WEB_SEARCH_STALE_IF_ERROR_SECONDS=1800

# Workspace knowledge retrieval. Docker Compose exposes Qdrant at localhost:6333.
ALCUIN_QDRANT_URL=http://localhost:6333
ALCUIN_QDRANT_API_KEY=
ALCUIN_DASHSCOPE_API_KEY=
ALCUIN_DASHSCOPE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
ALCUIN_QWEN_EMBEDDING_MODEL=text-embedding-v3

# Keep false in production. Set true only when testing trusted private/local MCP or OpenAPI endpoints.
ALCUIN_EXTENSION_ALLOW_PRIVATE_NETWORKS=false
ALCUIN_EXTENSION_HEALTH_TIMEOUT_SECONDS=5

# Optional generic OpenAI-compatible runtime. Without a matching key, Alcuin uses its demo runtime.
ALCUIN_OPENAI_API_KEY=
ALCUIN_OPENAI_BASE_URL=https://api.openai.com/v1
ALCUIN_OPENAI_MODEL=gpt-4.1-mini
ALCUIN_PROVIDER_MODE=responses

# Web
NEXT_PUBLIC_ALCUIN_API_URL=http://localhost:8000
NEXT_PUBLIC_ALCUIN_WORKSPACE_ID=ws_demo
