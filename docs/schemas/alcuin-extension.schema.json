{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alcuin.dev/schemas/alcuin-extension.schema.json",
  "title": "Alcuin Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "name", "version", "contributions", "entrypoints", "permissions"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$" },
    "description": { "type": "string", "maxLength": 500 },
    "compatibility": { "type": "string" },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "type": "object" } },
        "skills": { "type": "array", "items": { "type": "object" } },
        "agent_templates": { "type": "array", "items": { "type": "object" } },
        "knowledge_connectors": { "type": "array", "items": { "type": "object" } },
        "ui_blocks": { "type": "array", "items": { "type": "object" } }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "adapter"],
            "properties": {
              "type": { "const": "builtin" },
              "adapter": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "transport"],
            "properties": {
              "type": { "const": "mcp" },
              "transport": { "enum": ["stdio", "sse", "streamable_http"] },
              "command": { "type": ["string", "null"] },
              "args": { "type": "array", "items": { "type": "string" } },
              "url": { "type": ["string", "null"], "format": "uri" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "const": "openapi" },
              "spec_url": { "type": ["string", "null"], "format": "uri" },
              "base_url": { "type": ["string", "null"], "format": "uri" },
              "auth": { "enum": ["none", "api_key", "bearer"] }
            }
          }
        ]
      }
    },
    "config_schema": { "type": "object" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "risk", "required"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" },
          "risk": { "enum": ["low", "medium", "high"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "credential_requirements": { "type": "array", "items": { "type": "object" } }
  }
}
