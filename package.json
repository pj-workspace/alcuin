{
  "name": "alcuin",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @alcuin/web dev",
    "dev:api": "uv run --project apps/api uvicorn alcuin_api.main:app --reload --port 8000",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @alcuin/contracts test && uv run --project apps/api pytest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0"
  }
}
